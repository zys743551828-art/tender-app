{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tender:package-dependency-plan:1",
  "$ref": "#/$defs/View",
  "$defs": {
    "Assessment_Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "Assessment_Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "Assessment_Prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bid_id",
        "package_id",
        "revision_id",
        "inventory_id",
        "frozen_input_id",
        "execution_input_id",
        "execution_input_digest"
      ],
      "properties": {
        "bid_id": {
          "$ref": "#/$defs/Assessment_Id"
        },
        "package_id": {
          "$ref": "#/$defs/Assessment_Id"
        },
        "revision_id": {
          "$ref": "#/$defs/Assessment_Id"
        },
        "inventory_id": {
          "$ref": "#/$defs/Assessment_Id"
        },
        "frozen_input_id": {
          "$ref": "#/$defs/Assessment_Id"
        },
        "execution_input_id": {
          "$ref": "#/$defs/Assessment_Id"
        },
        "execution_input_digest": {
          "$ref": "#/$defs/Assessment_Digest"
        }
      }
    },
    "Assessment_Dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/Assessment_Id"
        },
        "requirement_digest": {
          "$ref": "#/$defs/Assessment_Digest"
        },
        "state": {
          "enum": [
            "unknown",
            "not_needed",
            "required"
          ]
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assessment_Id"
          },
          "uniqueItems": true,
          "maxItems": 500
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assessment_Id"
          },
          "uniqueItems": true,
          "maxItems": 500,
          "minItems": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      },
      "required": [
        "requirement_id",
        "requirement_digest",
        "state",
        "fact_ids",
        "evidence_ids",
        "reason"
      ]
    },
    "Assessment_Request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "const": "prebid_compliance"
        },
        "usage_digest": {
          "$ref": "#/$defs/Assessment_Digest"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assessment_Dependency"
          },
          "maxItems": 500
        }
      },
      "required": [
        "purpose",
        "usage_digest",
        "dependencies"
      ]
    },
    "Assessment_RequirementAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/Assessment_Id"
        },
        "requirement_digest": {
          "$ref": "#/$defs/Assessment_Digest"
        },
        "declaration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Assessment_Dependency"
            },
            {
              "type": "null"
            }
          ]
        },
        "fact_status": {
          "enum": [
            "unknown",
            "missing",
            "selected_unvalidated",
            "not_used"
          ]
        },
        "unselected_fact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assessment_Id"
          },
          "uniqueItems": true,
          "maxItems": 500
        },
        "coverage_state": {
          "enum": [
            "not_provided",
            "missing",
            "pending_parse",
            "parse_gap",
            "unsupported",
            "verified",
            "not_applicable",
            "conflict",
            "unknown"
          ]
        },
        "source_bound": {
          "type": "boolean"
        },
        "applicability": {
          "enum": [
            "applicable",
            "unknown",
            "not_applicable"
          ]
        }
      },
      "required": [
        "requirement_id",
        "requirement_digest",
        "declaration",
        "fact_status",
        "unselected_fact_ids",
        "coverage_state",
        "source_bound",
        "applicability"
      ]
    },
    "Assessment_Manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "package-input-dependencies/1"
        },
        "kind": {
          "const": "input_dependency_assessment"
        },
        "purpose": {
          "const": "prebid_compliance"
        },
        "prepared": {
          "$ref": "#/$defs/Assessment_Prepared"
        },
        "frozen_digest": {
          "$ref": "#/$defs/Assessment_Digest"
        },
        "inventory_digest": {
          "$ref": "#/$defs/Assessment_Digest"
        },
        "usage_digest": {
          "$ref": "#/$defs/Assessment_Digest"
        },
        "selected_fact_count": {
          "type": "integer",
          "minimum": 0
        },
        "requirement_count": {
          "type": "integer",
          "minimum": 0
        },
        "dependency_review_status": {
          "enum": [
            "incomplete",
            "declared"
          ]
        },
        "required_facts_assessment": {
          "enum": [
            "unknown",
            "missing",
            "selected_unvalidated",
            "not_used"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assessment_RequirementAssessment"
          }
        },
        "inventory_status": {
          "enum": [
            "unproven",
            "range_submitted_quality_unmeasured"
          ]
        },
        "declaration_kind": {
          "const": "human_dependency_annotation"
        },
        "inventory_complete": {
          "const": false
        },
        "original_bytes_verified": {
          "const": false
        },
        "facts_qualified": {
          "const": false
        },
        "review_ready": {
          "const": false
        },
        "launch_available": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        },
        "policy_digest": {
          "$ref": "#/$defs/Assessment_Digest"
        }
      },
      "required": [
        "version",
        "kind",
        "purpose",
        "prepared",
        "frozen_digest",
        "inventory_digest",
        "usage_digest",
        "selected_fact_count",
        "requirement_count",
        "dependency_review_status",
        "required_facts_assessment",
        "requirements",
        "inventory_status",
        "declaration_kind",
        "inventory_complete",
        "original_bytes_verified",
        "facts_qualified",
        "review_ready",
        "launch_available",
        "publication_authorized",
        "policy_digest"
      ]
    },
    "Assessment_View": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "$ref": "#/$defs/Assessment_Manifest"
        },
        "digest": {
          "$ref": "#/$defs/Assessment_Digest"
        }
      },
      "required": [
        "manifest",
        "digest"
      ]
    },
    "Usage_Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "Usage_Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "Usage_Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "fact_ids"
      ],
      "properties": {
        "purpose": {
          "const": "prebid_compliance"
        },
        "fact_ids": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Usage_Id"
          }
        }
      }
    },
    "Usage_Prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bid_id",
        "package_id",
        "revision_id",
        "inventory_id",
        "frozen_input_id",
        "execution_input_id",
        "execution_input_digest"
      ],
      "properties": {
        "bid_id": {
          "$ref": "#/$defs/Usage_Id"
        },
        "package_id": {
          "$ref": "#/$defs/Usage_Id"
        },
        "revision_id": {
          "$ref": "#/$defs/Usage_Id"
        },
        "inventory_id": {
          "$ref": "#/$defs/Usage_Id"
        },
        "frozen_input_id": {
          "$ref": "#/$defs/Usage_Id"
        },
        "execution_input_id": {
          "$ref": "#/$defs/Usage_Id"
        },
        "execution_input_digest": {
          "$ref": "#/$defs/Usage_Digest"
        }
      }
    },
    "Usage_Selected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "fact_item_digest"
      ],
      "properties": {
        "fact_id": {
          "$ref": "#/$defs/Usage_Id"
        },
        "fact_item_digest": {
          "$ref": "#/$defs/Usage_Digest"
        }
      }
    },
    "Usage_Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "purpose",
        "prepared",
        "identity_digest",
        "selected",
        "selection_digest",
        "selected_facts_digest",
        "required_facts_assessment",
        "facts_qualified",
        "review_ready",
        "launch_available",
        "publication_authorized"
      ],
      "properties": {
        "version": {
          "const": "package-fact-usage/1"
        },
        "kind": {
          "const": "fact_usage_selection"
        },
        "purpose": {
          "const": "prebid_compliance"
        },
        "prepared": {
          "$ref": "#/$defs/Usage_Prepared"
        },
        "identity_digest": {
          "$ref": "#/$defs/Usage_Digest"
        },
        "selected": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/Usage_Selected"
          }
        },
        "selection_digest": {
          "$ref": "#/$defs/Usage_Digest"
        },
        "selected_facts_digest": {
          "$ref": "#/$defs/Usage_Digest"
        },
        "required_facts_assessment": {
          "const": "not_performed"
        },
        "facts_qualified": {
          "const": false
        },
        "review_ready": {
          "const": false
        },
        "launch_available": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        }
      }
    },
    "Usage_View": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "digest"
      ],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/Usage_Manifest"
        },
        "digest": {
          "$ref": "#/$defs/Usage_Digest"
        }
      }
    },
    "Save": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_input_digest": {
          "$ref": "#/$defs/Assessment_Digest"
        },
        "purpose": {
          "const": "prebid_compliance"
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assessment_Id"
          },
          "maxItems": 500,
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assessment_Dependency"
          },
          "maxItems": 500
        },
        "assessment_digest": {
          "$ref": "#/$defs/Assessment_Digest"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      },
      "required": [
        "execution_input_digest",
        "purpose",
        "fact_ids",
        "dependencies",
        "assessment_digest",
        "reason"
      ]
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "package-dependency-plan/1"
        },
        "kind": {
          "const": "human_dependency_plan"
        },
        "id": {
          "$ref": "#/$defs/Assessment_Id"
        },
        "actor_id": {
          "$ref": "#/$defs/Assessment_Id"
        },
        "command_id": {
          "$ref": "#/$defs/Assessment_Id"
        },
        "saved_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "request_digest": {
          "$ref": "#/$defs/Assessment_Digest"
        },
        "prepared": {
          "$ref": "#/$defs/Assessment_Prepared"
        },
        "assessment": {
          "$ref": "#/$defs/Assessment_View"
        },
        "usage": {
          "$ref": "#/$defs/Usage_View"
        },
        "inventory_complete": {
          "const": false
        },
        "facts_qualified": {
          "const": false
        },
        "review_ready": {
          "const": false
        },
        "launch_available": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        }
      },
      "required": [
        "version",
        "kind",
        "id",
        "actor_id",
        "command_id",
        "saved_at",
        "reason",
        "request_digest",
        "prepared",
        "assessment",
        "usage",
        "inventory_complete",
        "facts_qualified",
        "review_ready",
        "launch_available",
        "publication_authorized"
      ]
    },
    "View": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "$ref": "#/$defs/Manifest"
        },
        "digest": {
          "$ref": "#/$defs/Assessment_Digest"
        }
      },
      "required": [
        "manifest",
        "digest"
      ]
    }
  }
}
