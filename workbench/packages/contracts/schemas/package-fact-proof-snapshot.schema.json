{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tender:package-fact-proof-snapshot:1",
  "$ref": "#/$defs/Snapshot",
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "Reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "evidence_id",
        "document_version_id"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/Id"
        },
        "source_revision": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_id": {
          "$ref": "#/$defs/Id"
        },
        "document_version_id": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "id",
        "document_version_id",
        "kind",
        "policy_class",
        "known_at",
        "digest",
        "revision",
        "status",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/Id"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "document_version_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string"
        },
        "policy_class": {
          "const": "prebid_content"
        },
        "known_at": {
          "type": "string",
          "format": "date-time"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "const": "published"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_id",
        "new_fact_id",
        "fact_set_id",
        "from_fact_id",
        "from_fact_set_id",
        "from_decision_id",
        "audit_digest",
        "audit_recorded_at",
        "actor_id",
        "command_id",
        "equivalence_digest",
        "previous_set_recorded"
      ],
      "properties": {
        "audit_id": {
          "$ref": "#/$defs/Id"
        },
        "new_fact_id": {
          "$ref": "#/$defs/Id"
        },
        "fact_set_id": {
          "$ref": "#/$defs/Id"
        },
        "from_fact_id": {
          "$ref": "#/$defs/Id"
        },
        "from_fact_set_id": {
          "$ref": "#/$defs/Id"
        },
        "from_decision_id": {
          "$ref": "#/$defs/Id"
        },
        "audit_digest": {
          "$ref": "#/$defs/Digest"
        },
        "audit_recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "command_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "equivalence_digest": {
          "$ref": "#/$defs/Digest"
        },
        "previous_set_recorded": {
          "type": "boolean"
        }
      }
    },
    "Proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "decision_binding",
        "decision_lineage",
        "references",
        "closure",
        "sources_effective",
        "evidence_usable"
      ],
      "properties": {
        "version": {
          "const": "package-fact-provenance/2"
        },
        "decision_binding": {
          "const": true
        },
        "decision_lineage": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "closure": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Source"
          }
        },
        "sources_effective": {
          "const": true
        },
        "evidence_usable": {
          "const": true
        }
      }
    },
    "Snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "observed_at",
        "proof"
      ],
      "properties": {
        "version": {
          "const": "package-fact-proof-snapshot/1"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{6}Z$"
        },
        "proof": {
          "$ref": "#/$defs/Proof"
        }
      }
    }
  }
}
