{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tender:package-fact-scope:1",
  "$ref": "#/$defs/Record",
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "Subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "engineering_project",
            "lot",
            "round",
            "bidder"
          ]
        },
        "id": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "ScopeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bid_id",
        "package_id",
        "revision_id",
        "inventory_id",
        "identity_digest",
        "frozen_input_id",
        "frozen_digest",
        "input_digest",
        "evidence_digest",
        "context_digest",
        "method_digest",
        "policy_digest",
        "purpose",
        "execution_input_id",
        "execution_input_digest",
        "facts_digest",
        "fact_set_id",
        "fact_id",
        "fact_item_digest",
        "proof_digest"
      ],
      "properties": {
        "bid_id": {
          "$ref": "#/$defs/Id"
        },
        "package_id": {
          "$ref": "#/$defs/Id"
        },
        "revision_id": {
          "$ref": "#/$defs/Id"
        },
        "inventory_id": {
          "$ref": "#/$defs/Id"
        },
        "identity_digest": {
          "$ref": "#/$defs/Digest"
        },
        "frozen_input_id": {
          "$ref": "#/$defs/Id"
        },
        "frozen_digest": {
          "$ref": "#/$defs/Digest"
        },
        "input_digest": {
          "$ref": "#/$defs/Digest"
        },
        "evidence_digest": {
          "$ref": "#/$defs/Digest"
        },
        "context_digest": {
          "$ref": "#/$defs/Digest"
        },
        "method_digest": {
          "$ref": "#/$defs/Digest"
        },
        "policy_digest": {
          "$ref": "#/$defs/Digest"
        },
        "purpose": {
          "const": "prebid_compliance"
        },
        "execution_input_id": {
          "$ref": "#/$defs/Id"
        },
        "execution_input_digest": {
          "$ref": "#/$defs/Digest"
        },
        "facts_digest": {
          "$ref": "#/$defs/Digest"
        },
        "fact_set_id": {
          "$ref": "#/$defs/Id"
        },
        "fact_id": {
          "$ref": "#/$defs/Id"
        },
        "fact_item_digest": {
          "$ref": "#/$defs/Digest"
        },
        "proof_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "id",
        "actor_id",
        "command_id",
        "recorded_at",
        "reason",
        "action",
        "previous_digest",
        "binding",
        "subject",
        "facts_qualified",
        "review_ready",
        "launch_available",
        "publication_authorized"
      ],
      "properties": {
        "version": {
          "const": "package-fact-scope/1"
        },
        "kind": {
          "const": "fact_scope_declaration"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "actor_id": {
          "$ref": "#/$defs/Id"
        },
        "command_id": {
          "$ref": "#/$defs/Id"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{6}Z$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "action": {
          "enum": [
            "bind",
            "withdraw"
          ]
        },
        "previous_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "binding": {
          "$ref": "#/$defs/ScopeBinding"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "facts_qualified": {
          "const": false
        },
        "review_ready": {
          "const": false
        },
        "launch_available": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "withdraw"
              }
            }
          },
          "then": {
            "properties": {
              "previous_digest": {
                "$ref": "#/$defs/Digest"
              }
            }
          }
        }
      ]
    },
    "Record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "digest"
      ],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/Manifest"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "Change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_input_digest",
        "fact_id",
        "action",
        "subject",
        "reason",
        "previous_digest"
      ],
      "properties": {
        "execution_input_digest": {
          "$ref": "#/$defs/Digest"
        },
        "fact_id": {
          "$ref": "#/$defs/Id"
        },
        "action": {
          "enum": [
            "bind",
            "withdraw"
          ]
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "previous_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "bind"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "$ref": "#/$defs/Subject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "withdraw"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "type": "null"
              },
              "previous_digest": {
                "$ref": "#/$defs/Digest"
              }
            }
          }
        }
      ]
    }
  }
}
