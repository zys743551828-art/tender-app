# syntax=docker/dockerfile:1.7@sha256:b5f3b260a9678e1d83d2fce86eeddf79420b79147eaba2a25986f47133d73720
# Build context: workbench. Supported platform: linux/amd64 only.
# Dependency image for the existing full Compose readonly source mounts.
FROM python:3.12.16-slim-bookworm@sha256:623674a14ef93d052bb9b0de4dbf5f28eb578a35263838941cc8aa43213c1487 AS wheels
WORKDIR /opt/workbench-locks
COPY requirements.lock.txt ./requirements.lock.txt
COPY deploy/fusion_full_requirements.txt ./deploy/fusion_full_requirements.txt
COPY deploy/requirements-build.lock.txt ./deploy/requirements-build.lock.txt
RUN python -m pip --isolated install --no-cache-dir --no-deps --only-binary=:all: \
        -r deploy/requirements-build.lock.txt \
    && python -m pip --isolated wheel --no-cache-dir --no-deps --no-build-isolation \
        --wheel-dir=/wheelhouse -r deploy/fusion_full_requirements.txt

FROM python:3.12.16-slim-bookworm@sha256:623674a14ef93d052bb9b0de4dbf5f28eb578a35263838941cc8aa43213c1487 AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONNOUSERSITE=1 \
    HOME=/tmp \
    WORKBENCH_ENV_FILE=explicit-fusion-full-no-inherited-profile
WORKDIR /opt/workbench-locks
COPY requirements.lock.txt ./requirements.lock.txt
COPY deploy/fusion_full_requirements.txt ./deploy/fusion_full_requirements.txt
COPY --from=wheels /wheelhouse /wheelhouse
RUN python -m pip --isolated install --no-index --no-cache-dir --no-deps --no-compile \
        --find-links=/wheelhouse -r deploy/fusion_full_requirements.txt \
    && python -m pip --isolated check \
    && rm -rf /wheelhouse
WORKDIR /workspace
USER 65532:65532
# Full Compose supplies each component's command and private runtime profile.
CMD ["python", "--version"]
