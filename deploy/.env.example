# =============================================================================
# 施组工作台 · 部署环境变量模板
#
# 用法：cp .env.example .env，然后按下面的说明修改；.env 不要提交到版本库（.gitignore 已忽略）。
# 本文件里不放任何口令：口令、密钥、证书私钥都在 ./secrets/ 目录（见 secrets/README.md）。
#
# 标记说明：
#   [必改]  含占位值，必须改成你们自己的值，scripts/preflight.sh 会检查
#   [必填]  没有内置默认值，缺了 docker compose 会直接报错
#   [可选]  有合理默认值，可保持不变
# compose 里的写法 ${VAR:?提示} 表示必填，${VAR:-默认值} 表示可选。
# =============================================================================

# -----------------------------------------------------------------------------
# 一、镜像（全部必填，标签固定版本，不使用 latest）
#
# 版本核对情况（2026-10-07，沙箱无法访问 Docker Hub，只能核对到下列程度；首次部署前请用
# `docker manifest inspect <镜像>` 或 `docker pull` 再确认一遍）：
#   postgres:16.15-bookworm   已在 docker-library/official-images 的 postgres 清单中核对到 16.15 与 -bookworm 标签
#   milvusdb/milvus:v2.6.10   取自 Milvus 官方 v2.6.11 标签下 docker-compose.yml 所引用的镜像
#   apache/kafka:4.0.0        Apache Kafka 4.0.0 的官方镜像（4.0 发布时已提供）；未在线核对，可升到同线最新补丁版本
#   bidwb-* 为本项目自己构建的镜像，标签随发版（建议用语义化版本或 git 短提交号）
# 使用私有镜像仓库或国内镜像加速时，直接把镜像名改成 registry.example.com/library/postgres:16.15-bookworm 即可。
# -----------------------------------------------------------------------------
# [必填] 后端镜像：api / worker / relay / reaper / migrate 共用。docker compose build api 会按这个名字打标签
APP_IMAGE=bidwb-backend:0.1.0
# [必填] 前端镜像（nginx + 静态资源）。docker compose build web
WEB_IMAGE=bidwb-web:0.1.0
# [必填] MLflow 镜像（本目录 mlflow/Dockerfile 构建）。docker compose build mlflow
MLFLOW_IMAGE=bidwb-mlflow:3.17.0
# [必填] PostgreSQL 16 的具体小版本
POSTGRES_IMAGE=postgres:16.15-bookworm
# [必填] Kafka（KRaft）
KAFKA_IMAGE=apache/kafka:4.0.0
# [必填] Milvus standalone
MILVUS_IMAGE=milvusdb/milvus:v2.6.10
# [仅开发环境必填] MinIO（模拟 OSS，只被 compose.dev.yml 使用）。milvusdb/minio 是 Milvus 官方示例所用的镜像，
# 标签取自 Milvus 官方 master 分支 docker-compose.yml（2026-10-07 核对）
MINIO_IMAGE=milvusdb/minio:RELEASE.2024-12-18T13-15-44Z

# -----------------------------------------------------------------------------
# 二、构建参数（只在 docker compose build 时用；直接拉取现成镜像可忽略）
# -----------------------------------------------------------------------------
# [可选] 构建镜像时写入 OCI 标签的版本号
APP_VERSION=0.1.0
# [可选] 构建时的基础镜像；内网环境改成私有仓库地址
PYTHON_IMAGE=python:3.11-slim-bookworm
NODE_IMAGE=node:22-alpine
# nginx-unprivileged 的 1.30.5-alpine 由官方 nginx 当前 stable 线版本推断（未验证：该标签是否存在）
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.30.5-alpine
# [可选] 国内网络的 PyPI / npm 镜像，留空表示用官方源。例如 https://mirrors.aliyun.com/pypi/simple/ 、https://registry.npmmirror.com
PIP_INDEX_URL=
NPM_REGISTRY=
# [可选] MLflow 版本（PyPI 2026-10-07 的最新版）。升级需同时执行 MLflow 库结构升级，见 README“升级”
MLFLOW_VERSION=3.17.0

# -----------------------------------------------------------------------------
# 三、站点与入口（web 容器）
# -----------------------------------------------------------------------------
# [必改][必填] 站点对外访问地址，必须是 https（后端生产模式会校验），不要以 / 结尾。
# 用于生成回调地址与 Cookie 策略；必须与用户浏览器里实际访问的地址一致。
PUBLIC_BASE_URL=https://tender.example.com
# [可选] 宿主机监听地址。默认所有网卡；只允许本机或前置 SLB 时可改为内网 IP
WEB_BIND_ADDR=0.0.0.0
# [可选] 宿主机端口，映射到容器 8080。默认模式（前面有 SLB 终止 TLS）用 8080；
# 用 compose.tls.yml 由 nginx 自己终止 TLS 时改为 80（80→443 跳转），443 由 WEB_HTTPS_PORT 控制
WEB_HTTP_PORT=8080
# [可选] 仅 compose.tls.yml 使用：宿主机 HTTPS 端口，映射到容器 8443
WEB_HTTPS_PORT=443
# [可选] nginx server_name，多数情况保持 _（匹配任意）
WEB_SERVER_NAME=_
# [启用 TLS 覆盖时] 在 .env 里追加一行（compose 自己会读取，不是本文件的变量）：
#   COMPOSE_FILE=compose.yml:compose.tls.yml
# [必改（仅 TLS 模式）] 80→443 跳转的目标主机，写域名（非 443 端口时带端口，如 tender.example.com:8443）
WEB_PUBLIC_HOST=tender.example.com
# [必改（默认模式）] 受信任的前置代理（SLB）网段，只有来自该网段的 X-Forwarded-For / X-Forwarded-Proto 才被采信。
# 默认 10.0.0.0/8 只是常见私网网段的占位，应收紧为 SLB 实际的私网地址段，否则限流与审计里的客户端 IP 可能不准。
WEB_SET_REAL_IP_FROM=10.0.0.0/8
# [必改][必填] CSP connect-src 里追加的来源：浏览器直传分片的 OSS 访问域名（多个用空格分隔）。
# 虚拟主机风格示例：https://<桶名>.oss-cn-hangzhou.aliyuncs.com；若用自定义域名则写自定义域名。
# 漏填会导致浏览器因 CSP 拒绝上传（控制台出现 Refused to connect）。
WEB_CSP_CONNECT_EXTRA=https://your-bucket-name.oss-cn-hangzhou.aliyuncs.com
# [可选] 登录接口按来源 IP 限速（nginx limit_req 格式）；后端另有账号维度限流，两层互补
WEB_LOGIN_RATE=10r/m
# [可选] 其余 /api/ 的整体限速
WEB_API_RATE=30r/s
# [可选] 请求体上限。上传走 OSS 直传不经过 nginx，所以很小即可
WEB_CLIENT_MAX_BODY_SIZE=5m

# -----------------------------------------------------------------------------
# 四、对象存储（阿里云 OSS，S3 兼容接口）。凭据在 secrets/oss_access_key_id 与 oss_secret_access_key
# -----------------------------------------------------------------------------
# [必改][必填] 服务端访问 OSS 的 S3 兼容端点，格式 https://s3.oss-<地域>.aliyuncs.com（阿里云“使用 Amazon S3 SDK 访问 OSS”文档）。
# 服务器在同地域阿里云 VPC 内时，可改用内网端点 https://s3.oss-<地域>-internal.aliyuncs.com 省流量费（未验证：内网 S3 端点格式）
OSS_ENDPOINT_URL=https://s3.oss-cn-hangzhou.aliyuncs.com
# [必改][必填] 浏览器直传用的端点（预签名地址里的主机）。浏览器在公网，所以必须是公网端点
OSS_PUBLIC_ENDPOINT_URL=https://s3.oss-cn-hangzhou.aliyuncs.com
# [必改][必填] 地域，如 cn-hangzhou（与桶所在地域一致）
OSS_REGION=cn-hangzhou
# [必改][必填] 桶名
OSS_BUCKET=your-bucket-name
# [可选] 寻址风格。阿里云 OSS 只支持 virtual；开发环境用 MinIO 时为 path
OSS_ADDRESSING_STYLE=virtual

# -----------------------------------------------------------------------------
# 五、模型与检索
# -----------------------------------------------------------------------------
# [可选] 大模型服务端点与模型名（凭据在 secrets/llm_api_key）。留空则 AI 类任务无法执行。
# 当前设计选用 DeepSeek（架构文档 3 节）；端点与模型名以供应商文档为准，下面是示例值
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# [可选] 检索通道：keyword（默认，关键词）或 milvus。当前后端只实现了关键词检索，设为 milvus 不会连接 Milvus；Milvus 通道须在评测胜过基线后才进入业务路径（架构文档 3 节）
RETRIEVAL_BACKEND=keyword
# [可选] 自动评审流水线（BIDWB_AUTO_ANALYSIS，默认 true）：资料齐全后自动解析、提取规则并评审。
# 设为 false 后各步骤只由人工触发，用于模型服务故障或需要控制调用成本时
AUTO_ANALYSIS=true
# [可选] 评分预测：每条评分条款的判断次数（1～7，次数越多越稳、调用越多）；比较式锚定每轮挑的锚点数（0 关闭，
# 只有登记了锚点包才生效）与拟合尺度 τ（分，百分制）。说明见 backend/README.md“AI 约定”
PREDICTION_REPEATS=3
PREDICTION_ANCHORS=6
PREDICTION_ANCHOR_TAU=6
# [可选] 日志级别 DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 六、Kafka 与 MLflow
# -----------------------------------------------------------------------------
# [必填] Kafka 集群 ID（22 位 base64url）。示例值可直接使用；数据卷创建后不能再改。
# 重新生成：python3 -c "import base64,uuid;print(base64.urlsafe_b64encode(uuid.uuid4().bytes).rstrip(b'=').decode())"
KAFKA_CLUSTER_ID=8_ZY--BXQEOkuYDUimDB2w
# [可选] 主题前缀。同一套 Kafka 承载多个环境（研究/验证/正式）时用来区分，如 prod.
KAFKA_TOPIC_PREFIX=
# [可选] MLflow 产物位置。留空则默认 s3://<OSS_BUCKET>/mlflow-artifacts（OSS 的 S3 兼容接入未验证）；
# 联调不通时回退为 file:///mlflow/artifacts（落本地卷，需自行纳入备份）
MLFLOW_ARTIFACT_URI=
# [可选] MLflow 界面在宿主机的本机端口（只绑定 127.0.0.1，经 SSH 隧道访问）
MLFLOW_UI_PORT=5000

# -----------------------------------------------------------------------------
# 七、运维脚本使用（不被 compose 引用）
# -----------------------------------------------------------------------------
# [可选] 备份目录（宿主机路径）。强烈建议指向与数据卷不同的物理磁盘或挂载点，不能只放在同一块盘上
BACKUP_DIR=./backups
# [可选] 保留策略：近 N 份每日备份 + 近 M 个月的月度备份（架构文档 8.3 初始策略：30 日 + 12 月）
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
# [可选] 备份时附带生成 OSS 对象清单的命令（输出写入备份批次的 oss-manifest.txt）。留空则只提示。
# 示例（需自行安装并配置 ossutil）：ossutil ls oss://your-bucket-name/ --short-format
BACKUP_OSS_MANIFEST_CMD=
# [可选] 首个管理员（scripts/create-admin.sh 与 compose.dev.yml 使用）。口令来自 secrets/admin_initial_password
ADMIN_LOGIN=admin
ADMIN_DISPLAY_NAME=系统管理员
